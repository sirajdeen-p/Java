async function demo() {
  const MAX_OPEN_TABS = 12;                    // Slightly reduced for stability
  let activeTabs = new Map();

  function clearEverySession() {
    try {
      sessionStorage.clear();
      localStorage.clear();

      const cookies = document.cookie.split(";");
      for (let cookie of cookies) {
        const name = cookie.split("=")[0].trim();
        document.cookie = `${name}=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=.youtube.com`;
        document.cookie = `${name}=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/`;
      }
    } catch (e) {}
  }

  function getRandom(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function cleanupTabs() {
    for (let [id, win] of activeTabs) {
      try {
        if (!win || win.closed) activeTabs.delete(id);
      } catch (e) {
        activeTabs.delete(id);
      }
    }
  }

  for (let i = 0; i < 1000; i++) {
    cleanupTabs();

    while (activeTabs.size >= MAX_OPEN_TABS) {
      await new Promise(r => setTimeout(r, 700));
      cleanupTabs();
    }

    clearEverySession();

    const win = window.open("https://youtube.com/shorts/oZT4bkWlHWE", "_blank");

    if (win) {
      const tabId = Date.now();
      activeTabs.set(tabId, win);

      // Random lifetime between 1s to 20s
      const randomLifetime = getRandom(1000, 50000);

      console.log(`Opened: ${i} | Active: ${activeTabs.size} | Lifetime: ${Math.round(randomLifetime/1000)}s`);

      setTimeout(() => {
        try {
          if (win && !win.closed) win.close();
          activeTabs.delete(tabId);
        } catch (e) {}
      }, randomLifetime);
    }

    // Random delay between 1.5s – 45s
    const delay = getRandom(1500, 45000);
    await new Promise(resolve => setTimeout(resolve, delay));
  }
}

