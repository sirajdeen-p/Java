11.Functional Interface
	one Abstract method will be there and n num of static and default method 
	
	public class MyClass {
		public static void main(String args[]) {

			//one way of creating Obj
			Func obj = ()-> {};
			Func.testStatic();
			obj.testDefault();

			//sec way of creating Obj
			A obj1 = new A();
			obj1.test();
			Func.testStatic();
			obj1.testDefault();

		}
	}

	class A implements  Func {
		@Override
		public void test() {
			System.out.println("test");
		}
	}

	interface Func {
		abstract void test();

		static void testStatic() {
			System.out.println("testStatic");
		}

		default void testDefault() {
			System.out.println("testDefault");
		}
	}
	
	
