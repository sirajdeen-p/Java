28.Serializable and deSerializable
	- process of converting java Objects into Byte stream then it is called Serializable ex txt file
	- process of converting Byte stream into java Objects then it is called DeSerializable ex txt file
	- it have id when deSerializable happeing java will compare the two ids and if that true then deserialization is allowed or InvalidClassExceptuon occurs
	
	
	import java.io.*;
	class Person implements Serializable {
		String name;
		transient int age;

		Person(String name, int age) {
			this.name = name;
			this.age = age;
		}
	}

public class Main {
    public static void main(String[] args) throws Exception {

        Person p = new Person("Siraj", 25);

        // ====================
        // SERIALIZATION
        // ====================

        ByteArrayOutputStream byteArray =
            new ByteArrayOutputStream();

        ObjectOutputStream out =
            new ObjectOutputStream(byteArray);

        out.writeObject(p);
        out.close();

        byte[] data = byteArray.toByteArray();

        System.out.println("Before serialization:");
        System.out.println("Name: " + p.name);
        System.out.println("Age: " + p.age);

        System.out.println("\nSerialized successfully!");
        System.out.println("Bytes: " + data.length);


        // ====================
        // DESERIALIZATION
        // ====================

        ByteArrayInputStream byteInput =
            new ByteArrayInputStream(data);

        ObjectInputStream in =
            new ObjectInputStream(byteInput);

        Person p2 = (Person) in.readObject();

        in.close();

        System.out.println("\nAfter deserialization:");
        System.out.println("Name: " + p2.name);
        System.out.println("Age: " + p2.age);
    }
}

