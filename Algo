	int max = 0;
	for(int i=0;i<nums.length;i++){
		
		if(ws < 0){
			ws = 0;
		}
		ws = ws + nums[i];
		if(ws > max){
		max = ws;
		}
	
	}

sliding window :
	int[] nums = {2,1,5,3,2,1};
	int k =2;
	int ws =0;
	for(int i=0;i<k;i++){
		ws+=nums[i];
	}
	int max = 0; max = ws;
	for(int i=k;i<nums.length;i++){
		ws+=nums[i] - nums[i-k];
		max = Math.max(ws,max);
	}

