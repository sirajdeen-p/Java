//custom thread pool executor
import java.util.concurrent.*;

public class ExecutorTest {

    public static void main(String[] args) throws ExecutionException, InterruptedException {

        BlockingQueue<Runnable> wQ = new LinkedBlockingQueue<>();

        ThreadPoolExecutor th = new ThreadPoolExecutor(
                1,
                1,
                10,
                TimeUnit.SECONDS,
                wQ,
                Executors.defaultThreadFactory(),
                new ThreadPoolExecutor.AbortPolicy()
        );

    //Runnable - dose nt return anything
    Future<?> fut = th.submit( () -> {System.out.println("hi");} );

    //Callable - return
    Future<Integer> fut1 = th.submit( () -> {
        System.out.println("hi");
        return 45 ;
    } );
    System.out.println(fut1.get());

    //Completable Future
        CompletableFuture cf = CompletableFuture.supplyAsync(()->{
                return "CompletableFuture"; }, th);
        System.out.println(cf.get());
    }
}

