  //rev func
  static int rev(int sq){
      int ans = 0;
      int rem;
      while(sq > 0){
      rem = sq  % 10;
      ans = ans * 10 + rem;
      sq  = sq  / 10;
    }
    return ans; 
  }

  //sq func
  static int sq(int n){
    return n * n;
  }

