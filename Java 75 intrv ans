22.Predicate, Consumer, Supplier, Function, BiFunction, Comparator with examples
	From java.util.function:

	Predicate<T>    → returns boolean 				test()
	Function<T, R>  → takes input, returns output   apply()
	Consumer<T> 	→ takes input, no return 	    accept()
	Supplier<T> 	→ returns value, no input 		get()

	Predicate<String> t = s -> s.equals("test");
	System.out.println(t.test("test"));
	
	Function<String,String> func = s -> s + "hi";
	System.out.println(func.apply("test "));
	
	Consumer<Integer> con = s -> System.out.println(s);
	con.accept(12345);
	
	Supplier<Double> sup = () -> Math.random();
	System.out.println(sup.get());
