import java.util.*;
import java.util.stream.*;

public class Main
{
	public static void main(String[] args) {
	    
	    List<Emplyoee> emp = new ArrayList<>();
	    
	    emp.add(new Emplyoee("siraj",10000,"eee"));
	    emp.add(new Emplyoee("aabb",20000,"eee"));
	    emp.add(new Emplyoee("bb",20000,"ece"));
	    emp.add(new Emplyoee("bb",50000,"rrr"));
	    
	    //sort
	    emp.stream()
	        .sorted(Comparator.comparing(Emplyoee::getName)).forEach(System.out::println);
	        
	    //rev sort
	    emp.stream()
	        .sorted(Comparator.comparing(Emplyoee::getName).reversed()).forEach(System.out::println);
	        
	        System.out.println("***************************");
	   //groupingBy
	   emp.stream()
	        .collect(Collectors.groupingBy(Emplyoee::getSalary))
	        .forEach((k,v)-> {
	            System.out.println(k);
	            v.forEach(System.out::println);
	        });
	        
	   //partitioningBy
	    System.out.println("***************************");
	   emp.stream()
	    .collect(Collectors.partitioningBy(e->e.getName().equals("siraj")))
	    .forEach((k,v)->{
	        System.out.println("Key = " + k);
	        v.forEach(System.out::println);
	    });

		
	
	
	}
}

class Emplyoee{
    
    private String name;
    private int salary;
    private String dept;
    
    public Emplyoee(String name,int salary, String dept){
        this.name = name;
        this.salary = salary;
        this.dept = dept;
    }
    
    
    public String getName(){
        return name;
    }
    
    public void setString(String name){
        this.name = name;
    }
    
    public int getSalary(){
        return salary;
    } 
    
    public void setSalary(int salary){
        this.salary = salary;
    }
    
    public String getDept(){
        return dept;
    }
    
    public void setDept(String dept){
        this.dept = dept;
    }
    
    @Override
    public String toString(){
        return String.format(name,salary,dept);
    }
    

}

